# =====================================================================
# 1. GRADLE Y BUILD TOOLS
# =====================================================================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
.gradle/caches/
.gradle/daemon/
.gradle/native/
.gradle/workers/
.gradle/checksums/
# Caché de classpath del language server de Kotlin/Gradle (no es datos de la app)
kls_database.db

# =====================================================================
# 2. JAVA Y COMPILACIÓN
# =====================================================================
*.class
# Archivos empaquetados (si no usas una carpeta build dedicada)
*.jar
*.war
*.ear
*.nar
# Logs de errores de la máquina virtual de Java (JVM)
hs_err_pid*
replay_pid*

# =====================================================================
# 3. ENTORNO, CREDENCIALES Y SECRETOS (SPRING BOOT)
# =====================================================================
.env
.env.local
# Archivos de configuración locales con credenciales o perfiles de desarrollo propios
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml

# =====================================================================
# 4. BASE DE DATOS Y DOCKER (PostgreSQL local)
# =====================================================================
# Volúmenes locales o datos persistentes de contenedores Docker
/pgdata/
/postgres_data/
/docker-data/

# =====================================================================
# 5. SISTEMAS OPERATIVOS
# =====================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Artefactos de transferencia NTFS/Alternate Data Streams
*:Zone.Identifier

# Linux
*~
.directory
.fuse_hidden*

